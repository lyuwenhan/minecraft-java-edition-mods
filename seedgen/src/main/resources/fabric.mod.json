{
	"schemaVersion": 1,
	"id": "seedgen",
	"version": "${version}",
	"name": "Seedgen",
	"description": "Locally generates vanilla terrain from a known world seed without requiring the server to generate it. Supports Voxy and Xaero's World Map.",
	"authors": [
		"Wenhan"
	],
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.example.seedgen.SeedgenMod"
		]
	},
	"mixins": [
		"seedgen.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"fabric-api": "*",
		"minecraft": "26.3",
		"java": ">=25"
	},
	"suggests": {
		"voxy": "*",
		"xaeroworldmap": "*"
	}
}
