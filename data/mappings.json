{
	"version": {
		"1.0": "1.21.11",
		"1.1": "26.1.2",
		"1.2": "26.3"
	},
	"mods": {
		"auto-greeting": {
			"hasIcon": true,
			"displayName": "Auto Greeting",
			"description": "Automatically sends greeting messages based on configured conditions.",
			"versions": {
				"1.21.11": "1.0.7",
				"26.1.2": "1.1.3",
				"26.3": "1.2.1"
			}
		},
		"auto-greeting-server": {
			"hasIcon": true,
			"displayName": "Auto Greeting - Server",
			"description": "Automatically sends greeting messages to players based on configured conditions.",
			"versions": {
				"1.21.11": "1.0.1",
				"26.1.2": "1.1.1",
				"26.3": "1.2.0"
			}
		},
		"auto-login": {
			"hasIcon": true,
			"displayName": "Auto Login",
			"description": "Automatically logs in to authentication servers using a locally encrypted password.",
			"versions": {
				"1.21.11": "1.0.3",
				"26.1.2": "1.1.2",
				"26.3": "1.2.0"
			}
		},
		"best-armor": {
			"hasIcon": true,
			"displayName": "Best Armor",
			"description": "Adds generated equipment shulker boxes to the operator creative tab.",
			"versions": {
				"26.1.2": "1.1.4",
				"26.3": "1.2.0"
			}
		},
		"better-elytra-takeoff": {
			"hasIcon": true,
			"displayName": "Better Elytra Takeoff",
			"description": "Starts Elytra gliding immediately while using fireworks.",
			"versions": {
				"1.21.11": "1.0.1",
				"26.1.2": "1.1.4",
				"26.3": "1.2.0"
			}
		},
		"better-step": {
			"hasIcon": true,
			"displayName": "Better Step",
			"description": "Improves player stepping by removing the vanilla ground restriction for stepping up and adding controlled stepping down.",
			"versions": {
				"26.1.2": "1.1.1",
				"26.3": "1.2.0"
			}
		},
		"boat-utils": {
			"hasIcon": true,
			"displayName": "Boat Utils",
			"description": "Client-side boat camera and movement utilities.",
			"versions": {
				"26.1.2": "1.1.6",
				"26.3": "1.2.0"
			}
		},
		"client-flying": {
			"hasIcon": true,
			"displayName": "Client Flying",
			"description": "Enables flight in Survival and Adventure modes without OP permissions.",
			"versions": {
				"1.21.11": "1.0.3",
				"26.1.2": "1.1.7",
				"26.3": "1.2.0"
			}
		},
		"creeper-no-break": {
			"hasIcon": true,
			"displayName": "Creeper No Break",
			"description": "Prevents creeper explosions from destroying blocks.",
			"versions": {
				"26.1.2": "1.1.1",
				"26.3": "1.2.0"
			}
		},
		"dabr-server-config-override": {
			"hasIcon": true,
			"displayName": "DABR Server Config Override",
			"description": "Overrides Do a Barrel Roll gameplay enforcement for forceEnabled and allowThrusting without altering the server settings UI.",
			"versions": {
				"26.1.2": "1.1.1",
				"26.3": "1.2.2"
			}
		},
		"double-jump": {
			"hasIcon": true,
			"displayName": "Double Jump",
			"description": "Adds configurable client-side multiple jumping.",
			"versions": {
				"26.1.2": "1.1.1",
				"26.3": "1.2.2"
			}
		},
		"entity-highlighter": {
			"hasIcon": false,
			"displayName": "Entity Highlighter",
			"description": "Client-side entity highlighting with configurable entity types, preset groups, and outline colors.",
			"versions": {
				"26.1.2": "1.1.0",
				"26.3": "1.2.0"
			}
		},
		"flight-disabler": {
			"hasIcon": true,
			"displayName": "Flight Disabler",
			"description": "Disables creative flight and elytra fall flying.",
			"versions": {
				"26.1.2": "1.1.1",
				"26.3": "1.2.0"
			}
		},
		"fly-speed-modifier": {
			"hasIcon": true,
			"displayName": "Fly Speed Modifier",
			"description": "Temporarily adjusts Freecam or player flight speed using a key and the mouse wheel.",
			"versions": {
				"26.1.2": "1.1.9",
				"26.3": "1.2.1"
			}
		},
		"forward-lock": {
			"hasIcon": true,
			"displayName": "Forward Lock",
			"description": "Double-tap forward to lock forward movement and sprinting until forward, backward, or crouch is pressed.",
			"versions": {
				"26.1.2": "1.1.1",
				"26.3": "1.2.0"
			}
		},
		"glideplate": {
			"hasIcon": true,
			"displayName": "Glideplate",
			"description": "Allows chestplates and Elytra to be combined in an anvil without XP costs or prior-work penalties.",
			"versions": {
				"1.21.11": "1.0.1",
				"26.1.2": "1.1.2",
				"26.3": "1.2.0"
			}
		},
		"hide-password": {
			"hasIcon": true,
			"displayName": "Hide Password",
			"description": "Hides password arguments entered in chat commands.",
			"versions": {
				"1.21.11": "1.0.6",
				"26.1.2": "1.1.4",
				"26.3": "1.2.0"
			}
		},
		"infinity-fireworks": {
			"hasIcon": true,
			"displayName": "Infinity Fireworks",
			"description": "Prevents firework rockets from being consumed when used.",
			"versions": {
				"1.21.11": "1.0.1",
				"26.1.2": "1.1.3",
				"26.3": "1.2.0"
			}
		},
		"no-hungry": {
			"hasIcon": true,
			"displayName": "No Hungry",
			"description": "Prevents player hunger and saturation from falling below configurable minimum levels.",
			"versions": {
				"26.1.2": "1.1.2",
				"26.3": "1.2.0"
			}
		},
		"player-highlighter": {
			"hasIcon": true,
			"displayName": "Player Highlighter",
			"description": "Highlights players with a glowing outline and a HUD target icon.",
			"versions": {
				"1.21.11": "1.0.8",
				"26.1.2": "1.1.3",
				"26.3": "1.2.0"
			}
		},
		"server-manager": {
			"hasIcon": true,
			"displayName": "Server Manager",
			"description": "Web server manager for Fabric dedicated servers.",
			"versions": {
				"26.1.2": "1.1.0",
				"26.3": "1.2.0"
			}
		},
		"shared-player-data": {
			"hasIcon": true,
			"displayName": "Shared Player Data",
			"description": "Shares vanilla player profile data among configured UUID groups.",
			"versions": {
				"26.1.2": "1.1.2",
				"26.3": "1.2.0"
			}
		},
		"who-i-am": {
			"hasIcon": true,
			"displayName": "Who I Am",
			"description": "Shows the local player's name tag in third-person or free-camera views, appends the player name to the window title, and provides the /i command.",
			"versions": {
				"26.1.2": "1.1.0",
				"26.3": "1.2.0"
			}
		}
	},
